# Copy to .env.local and fill in. Real values never go in git.

# Neon Postgres (pooled). Leave unset to use the embedded local database (./.pglite).
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# Neon Auth (Managed Better Auth)
NEON_AUTH_BASE_URL=
NEON_AUTH_JWKS_URL=
# Long random string used to sign the session cookie: openssl rand -base64 32
NEON_AUTH_COOKIE_SECRET=

# Public URL of this deployment, used in widget install snippets, invite links and the MCP URL.
# Optional on Vercel (derived from the request) but recommended once you have a custom domain.
APP_URL=
